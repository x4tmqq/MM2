        StarterGui:SetCore("SendNotification", {
            Title = "WindUI Error",
            Text = "Impossible de charger WindUI. Code: " .. tostring(result),
            Duration = 10,
        })
        return false
    end

    if not result then
        warn("WindUI returned nil")
        return false
    end

    WindUI = result
    return true
end

