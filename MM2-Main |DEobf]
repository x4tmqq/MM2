    local function startFakeDeath(animId)
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end
        local track = epsteinLoadAnimation(animId)
        if track then
            track.Looped = true
            track.Priority = Enum.AnimationPriority.Action
            track:Play()
        end
        local startPos = humanoid.RootPart and humanoid.RootPart.Position or Vector3.new()
        local monitor = RunService.Heartbeat:Connect(function()
            local currentPos = humanoid.RootPart and humanoid.RootPart.Position or Vector3.new()
            if (currentPos - startPos).Magnitude > 3 then
                track:Stop()
                monitor:Disconnect()
                pcall(function()
                    if WindUI and WindUI.Notify then
                        WindUI:Notify({ Title = "Fake Death", Content = "Stopped due to movement.", Duration = 2, Icon = "info" })
                    end
                end)
            end
        end)
        return track, monitor
    end

