            part.Position = UDim2.new(math.random(), 0, math.random(), 0)
            part.Parent = screenGui
            local targetY = math.random() * 0.3
            local duration = math.random() * 2 + 1
            TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                Position = UDim2.new(part.Position.X.Scale + math.random(-0.1, 0.1), 0, targetY, 0),
                BackgroundTransparency = 1
            }):Play()
            task.delay(duration, function() pcall(function() part:Destroy() end) end)
        end

        local Players = game:GetService("Players")
        local VIM = game:GetService("VirtualInputManager")
        local RunService = game:GetService("RunService")
        local player = Players.LocalPlayer
        local camera = workspace.CurrentCamera
        local character = player.Character or player.CharacterAdded:Wait()
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

        local originalCFrame = humanoidRootPart.CFrame

        humanoidRootPart.CFrame = CFrame.new(65, 24, -1714)
        task.wait(2)

        local function getProximityPrompts(maxDist)
            local results = {}
            local playerPos = humanoidRootPart.Position

            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") then
                    local part = obj.Parent
                    if part and part:IsA("BasePart") then
                        local dist = (part.Position - playerPos).Magnitude
                        if dist <= maxDist then
                            table.insert(results, {
                                name = obj.ActionText ~= "" and obj.ActionText or obj.Name,
                                part = part,
                                prompt = obj,
                                dist = dist
                            })
                        end
                    end
                end
            end

            table.sort(results, function(a, b) return a.dist < b.dist end)
            return results
        end

        local function lookAt(part)
            local targetPos = part.Position
            local camPos = humanoidRootPart.Position + Vector3.new(0, 2, 0)
            camera.CameraType = Enum.CameraType.Scriptable
            camera.CFrame = CFrame.lookAt(camPos, targetPos)
            task.wait(0.1)
            camera.CameraType = Enum.CameraType.Custom
        end

        local function triggerPrompt(prompt)
            local oldDist = prompt.MaxActivationDistance
            prompt.MaxActivationDistance = 999
            
            fireproximityprompt(prompt)
            task.wait(0.2)
            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(3.3)
            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            task.wait(0.3)
            
            prompt.MaxActivationDistance = oldDist
        end

        local prompts = getProximityPrompts(100)
        print(string.format("%d prompt(s) trouvé(s)", #prompts))
        for i, p in ipairs(prompts) do
            print(string.format("%d. [%s] %.1f studs", i, p.name, p.dist))
        end

        for i = 1, math.min(3, #prompts) do
            local p = prompts[i]
            humanoidRootPart.CFrame = CFrame.new(p.part.Position + Vector3.new(0, 3, 0))
            task.wait(0.5)
            lookAt(p.part)
            task.wait(0.3)
            triggerPrompt(p.prompt)
            print(string.format("Fired: %s", p.name))
            task.wait(1.2)
        end

        print("Done.")
        
        pcall(function() screenGui:Destroy() end)
        pcall(function() if WindUI then WindUI:Notify({ Title = "Weapons", Content = "Rasonian weapons collected successfully!", Duration = 3 }) end end)

        task.wait(0.5)
        humanoidRootPart.CFrame = originalCFrame
        print("Returned to original position.")
    end)
end

