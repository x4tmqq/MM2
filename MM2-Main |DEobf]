local function setupWallBang(enabled)
    Config.WallBangEnabled = enabled

    if wallBangConnection then
        wallBangConnection:Disconnect()
        wallBangConnection = nil
    end

    if not enabled then
        if wallBangRemoteEvent and originalShootFireServer then
            wallBangRemoteEvent.FireServer = originalShootFireServer
            originalShootFireServer = nil
            wallBangRemoteEvent = nil
        end
        return
    end

    if not hookSupported then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({
                    Title = "Wall Bang",
                    Content = "Your executor does not support hooks. Wall Bang cannot be activated.",
                    Duration = 8,
                    Icon = "alert-triangle"
                })
            end
        end)
        return
    end

    local remote, tool = findShootRemoteInTool()
    if not remote then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({
                    Title = "Wall Bang",
                    Content = "You are not Sheriff. Equip a gun to use Wall Bang.",
                    Duration = 5,
                    Icon = "shield-off"
                })
            end
        end)
        return
    end

    wallBangRemoteEvent = remote
    if not originalShootFireServer then
        originalShootFireServer = remote.FireServer
    end

    remote.FireServer = function(self, worldCFrame, mouseTargetCFrame)
        local player = LocalPlayer
        local char = player.Character
        if not char then return originalShootFireServer(self, worldCFrame, mouseTargetCFrame) end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return originalShootFireServer(self, worldCFrame, mouseTargetCFrame) end

        local target = getClosestMurdererForSilent()
        if not target then
            return originalShootFireServer(self, worldCFrame, mouseTargetCFrame)
        end

        local originalCF = root.CFrame
        local dirToTarget = (target.Position - originalCF.Position).Unit
        local newPos = target.Position - dirToTarget * 0.5

        local noclipState = Config.NoclipEnabled
        if not noclipState then
            setNoclip(true)
        end

        root.CFrame = CFrame.new(newPos)
        local result = originalShootFireServer(self, CFrame.new(newPos), CFrame.new(target.Position))

        task.defer(function()
            if root and root.Parent then
                root.CFrame = originalCF
                if not noclipState then
                    setNoclip(false)
                end
            end
        end)

        return result
    end

    local ws = getWeaponService()
    if ws then
        if not originalGetMouseTarget then
            originalGetMouseTarget = ws.GetMouseTargetCFrame
            originalGetTargetPosition = ws.GetTargetPosition
            originalWeaponRaycast = ws.WeaponRaycast
        end
        ws.GetMouseTargetCFrame = function(self)
            local t = getClosestMurdererForSilent()
            if t then return CFrame.new(t.Position) end
            return originalGetMouseTarget(self)
        end
        ws.GetTargetPosition = function(self, x, y)
            local t = getClosestMurdererForSilent()
            if t then return CFrame.new(t.Position) end
            return originalGetTargetPosition(self, x, y)
        end
        ws.WeaponRaycast = function(ray)
            return nil
        end
    end

    wallBangConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local cantShoot = tool:FindFirstChild("CantShoot")
                if cantShoot then
                    pcall(function()
                        cantShoot.Enabled = false
                        cantShoot:Destroy()
                    end)
                end
            end
        end
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    local cantShoot = tool:FindFirstChild("CantShoot")
                    if cantShoot then
                        pcall(function()
                            cantShoot.Enabled = false
                            cantShoot:Destroy()
                        end)
                    end
                end
            end
        end
    end)
    maid:add(wallBangConnection)
end

local originalGetMouseTarget = nil
local originalGetTargetPosition = nil
local originalWeaponRaycast = nil

local function getClosestMurdererForSilent()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local screenCenter = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local target, shortestDistance = nil, (Config.SilentAimUseFOV and Config.SilentAimFOVRadius or math.huge)
    for _, v in pairs(Players:GetPlayers()) do
        if v == LocalPlayer then continue end
        local role, _ = getPlayerRole(v)
        if role ~= "Murderer" then continue end
        local char = v.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local magnitude = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
            if magnitude < shortestDistance then
                shortestDistance = magnitude
                target = hrp
            end
        end
    end
    return target
end

