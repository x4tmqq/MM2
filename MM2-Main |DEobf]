        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local tween = TweenService:Create(cam, tweenInfo, {FieldOfView = targetFOV})
        tween:Play()
    end
end

