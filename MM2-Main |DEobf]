    if ESP.MurdererHighlight or ESP.SheriffHighlight or ESP.InnocentHighlight
    or ESP.MurdererTracer or ESP.SheriffTracer or ESP.InnocentTracer
    or ESP.MurdererSkeleton or ESP.SheriffSkeleton or ESP.InnocentSkeleton then
