local function getKnifeDirection(knife: BasePart): Vector3?
    local dir = knife:GetAttribute("Direction")
    if type(dir) == "Vector3" then
        return dir
    end
    return nil
end

local function isInKnifeList(knife: BasePart): boolean
    for _, k in ipairs(dodgeKnifeList) do
        if k == knife then
            return true
        end
    end
    return false
end

local function removeKnifeFromList(knife: BasePart)
    for i, k in ipairs(dodgeKnifeList) do
        if k == knife then
            table.remove(dodgeKnifeList, i)
            break
        end
    end
    if Config.DodgeMethod == "SafePlace" and isInSafePlace and #dodgeKnifeList == 0 then
        returnFromSafePlace()
    end
end

local function performSafePlace()
    if isInSafePlace then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    safePlaceOriginalPos = root.Position
    local safePos = Vector3.new(root.Position.X, 1000, root.Position.Z)
    root.CFrame = CFrame.new(safePos)
    isInSafePlace = true
end

local function returnFromSafePlace()
    if not isInSafePlace then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if safePlaceOriginalPos then
        root.CFrame = CFrame.new(safePlaceOriginalPos)
        safePlaceOriginalPos = nil
    end
    isInSafePlace = false
end

local function performDodge(knife: BasePart)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local dir = getKnifeDirection(knife)
    if not dir then return end
    local up = Vector3.new(0, 1, 0)
    local lateral = dir:Cross(up)
    if lateral.Magnitude < 0.01 then
        lateral = Vector3.new(1, 0, 0)
    end
    lateral = lateral.Unit
    local speed = 30
    local velocity = lateral * speed + Vector3.new(0, 10, 0)
    root.Velocity = velocity
end

local function handleKnifeAdded(knife: BasePart)
    if not Config.DodgeKnifeThrow then return end
    if not knife:IsA("BasePart") or knife.Name ~= "KnifeVisual" then return end
    if isInKnifeList(knife) then return end
    
    table.insert(dodgeKnifeList, knife)
    
    local destroyConn
    destroyConn = knife.AncestryChanged:Connect(function()
        if not knife.Parent then
            destroyConn:Disconnect()
            removeKnifeFromList(knife)
        end
    end)
    
    if Config.DodgeMethod == "SafePlace" then
        performSafePlace()
    elseif Config.DodgeMethod == "Dodge" then
        performDodge(knife)
    end
end

local function startDodge()
    if dodgeDescendantAddedConn then
        dodgeDescendantAddedConn:Disconnect()
        dodgeDescendantAddedConn = nil
    end
    
    dodgeActive = false
    
    if not Config.DodgeKnifeThrow then return end
    
    dodgeActive = true
    table.clear(dodgeKnifeList)
    
    dodgeDescendantAddedConn = Workspace.DescendantAdded:Connect(function(child)
        if child:IsA("BasePart") and child.Name == "KnifeVisual" then
            handleKnifeAdded(child)
        end
    end)
    maid:add(dodgeDescendantAddedConn)
    
    for _, child in ipairs(Workspace:GetDescendants()) do
        if child:IsA("BasePart") and child.Name == "KnifeVisual" then
            handleKnifeAdded(child)
        end
    end
end

local function stopDodge()
    if dodgeDescendantAddedConn then
        dodgeDescendantAddedConn:Disconnect()
        dodgeDescendantAddedConn = nil
    end
    dodgeActive = false
    if isInSafePlace then
        returnFromSafePlace()
    end
    table.clear(dodgeKnifeList)
end

