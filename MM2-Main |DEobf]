type CleanupItem = RBXScriptConnection | (() -> ()) | Instance

local Maid = {}
Maid.__index = Maid

function Maid.new(): any
    return setmetatable({ _items = {} }, Maid)
end

function Maid:add(item: CleanupItem): CleanupItem
    table.insert(self._items, item)
    return item
end

function Maid:cleanup()
    local items = self._items
    for i = #items, 1, -1 do
        local item = items[i]
        local itemType = typeof(item)
        if itemType == "RBXScriptConnection" then
            item:Disconnect()
        elseif itemType == "function" then
            item()
        elseif itemType == "Instance" then
            item:Destroy()
        end
    end
    table.clear(items)
end

