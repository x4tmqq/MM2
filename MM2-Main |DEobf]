local function flingPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end

    local char = LocalPlayer.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local rootPart = humanoid and humanoid.RootPart
    if not char or not humanoid or not rootPart then return end

    local tChar = targetPlayer.Character
    if not tChar then return end
    local tHumanoid = tChar:FindFirstChildOfClass("Humanoid")
    if not tHumanoid or tHumanoid.Health <= 0 then return end
    local tRootPart = tHumanoid.RootPart
    local tHead = tChar:FindFirstChild("Head")
    local accessory = tChar:FindFirstChildOfClass("Accessory")
    local handle = accessory and accessory:FindFirstChild("Handle")

    if rootPart.Velocity.Magnitude < 50 then
        flingOldPos = rootPart.CFrame
    end

    if tHead then
        workspace.CurrentCamera.CameraSubject = tHead
    elseif handle then
        workspace.CurrentCamera.CameraSubject = handle
    elseif tRootPart then
        workspace.CurrentCamera.CameraSubject = tHumanoid
    end

    if not tChar:FindFirstChildWhichIsA("BasePart") then
        return
    end

    local function setPos(basePart, offset, angle)
        rootPart.CFrame = CFrame.new(basePart.Position) * offset * angle
        char:SetPrimaryPartCFrame(CFrame.new(basePart.Position) * offset * angle)
        rootPart.Velocity = Vector3.new(9e7, 9e8, 9e7)
        rootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
    end

    local function flingLoop(basePart)
        local start = tick()
        local duration = 2
        local angle = 0
        repeat
            if rootPart and tHumanoid and tChar and tChar.Parent and targetPlayer.Parent then
                if basePart.Velocity.Magnitude < 50 then
                    angle = angle + 100
                    setPos(basePart, CFrame.new(0, 1.5, 0) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(2.25, 1.5, -2.25) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(-2.25, -1.5, 2.25) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, 1.5, 0) + tHumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0) + tHumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                    task.wait()
                else
                    setPos(basePart, CFrame.new(0, 1.5, tHumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, -tHumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, 1.5, tHumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, 1.5, tRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, -tRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(0, 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, 1.5, tRootPart.Velocity.Magnitude / 1.25), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(-90), 0, 0))
                    task.wait()
                    setPos(basePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                    task.wait()
                end
            else
                break
            end
        until basePart.Velocity.Magnitude > 500 or basePart.Parent ~= tChar or targetPlayer.Parent ~= Players or tHumanoid.Sit or humanoid.Health <= 0 or tick() > start + duration
    end

    local oldFallHeight = workspace.FallenPartsDestroyHeight
    workspace.FallenPartsDestroyHeight = 0/0

    local bv = Instance.new("BodyVelocity")
    bv.Name = "EpixVel"
    bv.Parent = rootPart
    bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
    bv.MaxForce = Vector3.new(1/0, 1/0, 1/0)

    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

    if tRootPart and tHead then
        if (tRootPart.Position - tHead.Position).Magnitude > 5 then
            flingLoop(tHead)
        else
            flingLoop(tRootPart)
        end
    elseif tRootPart then
        flingLoop(tRootPart)
    elseif tHead then
        flingLoop(tHead)
    elseif handle then
        flingLoop(handle)
    else
        bv:Destroy()
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        workspace.FallenPartsDestroyHeight = oldFallHeight
        return
    end

    bv:Destroy()
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
    workspace.CurrentCamera.CameraSubject = humanoid

    if flingOldPos then
        repeat
            rootPart.CFrame = flingOldPos * CFrame.new(0, 0.5, 0)
            char:SetPrimaryPartCFrame(flingOldPos * CFrame.new(0, 0.5, 0))
            humanoid:ChangeState("GettingUp")
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.Velocity = Vector3.new()
                    part.RotVelocity = Vector3.new()
                end
            end
            task.wait()
        until (rootPart.Position - flingOldPos.Position).Magnitude < 25
    end

    workspace.FallenPartsDestroyHeight = oldFallHeight
end

