local function getPlayerRole(player)
    local playerName = player.Name
    local roleFromData = nil

    if Sync and Sync[playerName] and Sync[playerName].Role then
        roleFromData = Sync[playerName].Role
    elseif PlayerRoles[playerName] then
        roleFromData = PlayerRoles[playerName].Role
    elseif Event and PlayerData[playerName] and PlayerData[playerName].Role then
        roleFromData = PlayerData[playerName].Role
    end

    local baseRole = nil
    local color = nil

    if roleFromData then
        if roleFromData == "Murderer" then
            baseRole = "Murderer"
            color = ESP.MurdererColor
        elseif roleFromData == "Sheriff" then
            baseRole = "Sheriff"
            color = ESP.SheriffColor
        elseif roleFromData == "Hero" then
            if sheriffHasGun then
                baseRole = "Innocent"
                color = ESP.InnocentColor
            else
                baseRole = "Hero"
                color = ESP.HeroColor
            end
        else
            baseRole = "Innocent"
            color = ESP.InnocentColor
        end
    else
        local char = player.Character
        local hasGun = false
        local hasKnife = false

        if char then
            if hasItemEquipped(char, "Knife") or hasItemEquipped(char, "knife") then
                hasKnife = true
            end
            if hasItemEquipped(char, "Gun") or hasItemEquipped(char, "gun") then
                hasGun = true
            end
        end
        if not hasKnife and hasItemInBackpack(player, "Knife") then
            hasKnife = true
        end
        if not hasGun and hasItemInBackpack(player, "Gun") then
            hasGun = true
        end

        if hasKnife then
            baseRole = "Murderer"
            color = ESP.MurdererColor
        elseif hasGun then
            if sheriffHasGun then
                baseRole = "Innocent"
                color = ESP.InnocentColor
            else
                baseRole = "Hero"
                color = ESP.HeroColor
            end
        else
            baseRole = "Innocent"
            color = ESP.InnocentColor
        end
    end

    return baseRole, color
end

local function updateSheriffStatus()
    sheriffHasGun = false
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local roleFromData = nil
        local name = player.Name
        if Sync and Sync[name] and Sync[name].Role then
            roleFromData = Sync[name].Role
        elseif PlayerRoles[name] then
            roleFromData = PlayerRoles[name].Role
        elseif Event and PlayerData[name] and PlayerData[name].Role then
            roleFromData = PlayerData[name].Role
        end
        if roleFromData == "Sheriff" then
            local char = player.Character
            if char and hasItemEquipped(char, "Gun") then
                sheriffHasGun = true
                break
            end
            if hasItemInBackpack(player, "Gun") then
                sheriffHasGun = true
                break
            end
        end
    end
end

local function clearESP()
    for player, hl in pairs(highlightCache) do
        if hl then hl:Destroy() end
    end
    table.clear(highlightCache)

    if Drawing then
        for id, line in pairs(tracerCache) do
            if line then line.Visible = false end
        end
    end

    for player, lines in pairs(skeletonCache) do
        for _, line in pairs(lines) do
            if line then line.Visible = false end
        end
    end
end

local function updateHighlights()
    local localChar = LocalPlayer.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local activeHighlightRoles = {}
    if ESP.MurdererHighlight then activeHighlightRoles["Murderer"] = true end
    if ESP.SheriffHighlight then activeHighlightRoles["Sheriff"] = true end
    if ESP.InnocentHighlight then activeHighlightRoles["Innocent"] = true end
    if ESP.InnocentHighlight or ESP.SheriffHighlight then activeHighlightRoles["Hero"] = true end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local role, color = getPlayerRole(player)
        local shouldHighlight = activeHighlightRoles[role] or false

        local withinDistance = true
        if shouldHighlight and ESP.MaxDistance > 0 then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and localRoot then
                local dist = (root.Position - localRoot.Position).Magnitude
                if dist > ESP.MaxDistance then
                    withinDistance = false
                end
            else
                withinDistance = false
            end
        end

        local hl = highlightCache[player]
        if shouldHighlight and withinDistance then
            local adornee = player.Character or player
            if not hl then
                hl = Instance.new("Highlight")
                highlightCache[player] = hl
            end
            hl.Adornee = adornee
            hl.FillColor = color
            hl.FillTransparency = Config.HLFillTrans
            hl.OutlineColor = color
            hl.OutlineTransparency = Config.HLOutlineTrans
            hl.Parent = adornee
            hl.Enabled = true
        else
            if hl then
                hl:Destroy()
                highlightCache[player] = nil
            end
        end
    end
end

local function getTracer(id)
    if not Drawing then return nil end
    if not tracerCache[id] then
        local line = Drawing.new("Line")
        line.Thickness = 1.5
        line.Transparency = 1
        tracerCache[id] = line
    end
    return tracerCache[id]
end

local function createSkeletonLine()
    if not Drawing then return nil end
    local line = Drawing.new("Line")
    line.Thickness = ESP.SkeletonThickness
    line.Transparency = 1
    line.Visible = false
    return line
end

local function getSkeletonLines(player)
    if not skeletonCache[player] then
        skeletonCache[player] = {}
        for i = 1, 12 do
            skeletonCache[player][i] = createSkeletonLine()
        end
    end
    return skeletonCache[player]
end

local function updateTracers()
    if not Drawing then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local activeTracerRoles = {}
    if ESP.MurdererTracer then activeTracerRoles["Murderer"] = true end
    if ESP.SheriffTracer then activeTracerRoles["Sheriff"] = true end
    if ESP.InnocentTracer then activeTracerRoles["Innocent"] = true end
    if ESP.InnocentTracer or ESP.SheriffTracer then activeTracerRoles["Hero"] = true end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local line = getTracer(tostring(player.UserId))
        if not line then continue end

        if not root then
            line.Visible = false
            continue
        end

        local role, color = getPlayerRole(player)
        local shouldTracer = activeTracerRoles[role] or false

        if shouldTracer and ESP.MaxDistance > 0 then
            local dist = (root.Position - localRoot.Position).Magnitude
            if dist > ESP.MaxDistance then
                line.Visible = false
                continue
            end
        end

        if shouldTracer then
            local vector, onScreen = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 1.5, 0))
            if onScreen then
                line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                line.To = Vector2.new(vector.X, vector.Y)
                line.Color = color
                line.Thickness = 1.5
                line.Transparency = 1
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

local function updateSkeletons()
    if not Drawing then return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end

    local activeSkeletonRoles = {}
    if ESP.MurdererSkeleton then activeSkeletonRoles["Murderer"] = true end
    if ESP.SheriffSkeleton then activeSkeletonRoles["Sheriff"] = true end
    if ESP.InnocentSkeleton then activeSkeletonRoles["Innocent"] = true end
    if ESP.InnocentSkeleton or ESP.SheriffSkeleton then activeSkeletonRoles["Hero"] = true end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then
            if skeletonCache[player] then
                for _, line in pairs(skeletonCache[player]) do
                    if line then line.Visible = false end
                end
            end
            continue
        end

        local role, color = getPlayerRole(player)
        local shouldSkeleton = activeSkeletonRoles[role] or false

        if not shouldSkeleton then
            if skeletonCache[player] then
                for _, line in pairs(skeletonCache[player]) do
                    if line then line.Visible = false end
                end
            end
            continue
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            if skeletonCache[player] then
                for _, line in pairs(skeletonCache[player]) do
                    if line then line.Visible = false end
                end
            end
            continue
        end

        if ESP.MaxDistance > 0 then
            local dist = (root.Position - localRoot.Position).Magnitude
            if dist > ESP.MaxDistance then
                if skeletonCache[player] then
                    for _, line in pairs(skeletonCache[player]) do
                        if line then line.Visible = false end
                    end
                end
                continue
            end
        end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then
            if skeletonCache[player] then
                for _, line in pairs(skeletonCache[player]) do
                    if line then line.Visible = false end
                end
            end
            continue
        end

        local lines = getSkeletonLines(player)
        if not lines then continue end

        local joints = {}
        local connections = {}

        if humanoid.RigType == Enum.HumanoidRigType.R15 then
            joints = {
                ["Head"] = char:FindFirstChild("Head"),
                ["UpperTorso"] = char:FindFirstChild("UpperTorso"),
                ["LowerTorso"] = char:FindFirstChild("LowerTorso"),
                ["LeftUpperArm"] = char:FindFirstChild("LeftUpperArm"),
                ["LeftLowerArm"] = char:FindFirstChild("LeftLowerArm"),
                ["LeftHand"] = char:FindFirstChild("LeftHand"),
                ["RightUpperArm"] = char:FindFirstChild("RightUpperArm"),
                ["RightLowerArm"] = char:FindFirstChild("RightLowerArm"),
                ["RightHand"] = char:FindFirstChild("RightHand"),
                ["LeftUpperLeg"] = char:FindFirstChild("LeftUpperLeg"),
                ["LeftLowerLeg"] = char:FindFirstChild("LeftLowerLeg"),
                ["RightUpperLeg"] = char:FindFirstChild("RightUpperLeg"),
                ["RightLowerLeg"] = char:FindFirstChild("RightLowerLeg"),
            }
            connections = {
                { "Head", "UpperTorso" },
                { "UpperTorso", "LowerTorso" },
                { "LowerTorso", "LeftUpperLeg" },
                { "LeftUpperLeg", "LeftLowerLeg" },
                { "LowerTorso", "RightUpperLeg" },
                { "RightUpperLeg", "RightLowerLeg" },
                { "UpperTorso", "LeftUpperArm" },
                { "LeftUpperArm", "LeftLowerArm" },
                { "LeftLowerArm", "LeftHand" },
                { "UpperTorso", "RightUpperArm" },
                { "RightUpperArm", "RightLowerArm" },
                { "RightLowerArm", "RightHand" },
            }
        elseif humanoid.RigType == Enum.HumanoidRigType.R6 then
            joints = {
                ["Head"] = char:FindFirstChild("Head"),
                ["Torso"] = char:FindFirstChild("Torso"),
                ["LeftLeg"] = char:FindFirstChild("Left Leg"),
                ["RightLeg"] = char:FindFirstChild("Right Leg"),
                ["LeftArm"] = char:FindFirstChild("Left Arm"),
                ["RightArm"] = char:FindFirstChild("Right Arm"),
            }
            connections = {
                { "Head", "Torso" },
                { "Torso", "LeftArm" },
                { "Torso", "RightArm" },
                { "Torso", "LeftLeg" },
                { "Torso", "RightLeg" },
            }
        else
            for _, line in pairs(lines) do
                if line then line.Visible = false end
            end
            continue
        end

        for index, connection in ipairs(connections) do
            local jointA = joints[connection[1]]
            local jointB = joints[connection[2]]
            local line = lines[index]
            if not line then continue end

            if jointA and jointB then
                local posA, onScreenA = cam:WorldToViewportPoint(jointA.Position)
                local posB, onScreenB = cam:WorldToViewportPoint(jointB.Position)

                line.Color = color
                line.Thickness = ESP.SkeletonThickness
                line.Transparency = 1

                if onScreenA and onScreenB then
                    if humanoid.RigType == Enum.HumanoidRigType.R6 then
                        if connection[2] == "LeftArm" or connection[2] == "RightArm" then
                            local offsetY = 0.5
                            posB = cam:WorldToViewportPoint(jointB.Position + Vector3.new(0, offsetY, 0))
                        end
                    end
                    line.From = Vector2.new(posA.X, posA.Y)
                    line.To = Vector2.new(posB.X, posB.Y)
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        end

        for i = #connections + 1, 12 do
            local line = lines[i]
            if line then line.Visible = false end
        end
    end
end

local function refreshESP()
    updateSheriffStatus()
    updateHighlights()
    updateTracers()
    updateSkeletons()
end

local function startESP()
    clearESP()
    refreshESP()

    if ESPUpdateConnection then
        ESPUpdateConnection:Disconnect()
        ESPUpdateConnection = nil
    end

    ESPUpdateConnection = RunService.Heartbeat:Connect(function()
        updateTracers()
        updateSkeletons()
    end)
    maid:add(ESPUpdateConnection)
end

