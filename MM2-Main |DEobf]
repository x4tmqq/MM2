local function setupCharacter(char)
    if currentCharacter == char then return end
    if characterMaid then
        characterMaid:cleanup()
        characterMaid = nil
    end

    currentCharacter = char
    characterMaid = Maid.new()

    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        task.wait(0.5)
        humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
    end

    setWalkSpeed(Config.WalkSpeedEnabled, Config.WalkSpeed)
    setJumpPower(Config.JumpPowerEnabled, Config.JumpPower)
