local function setupSilentAim(enabled)
    Config.SilentAimEnabled = enabled
    silentActive = enabled

    local ws = getWeaponService()
    if not ws then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Silent Aim", Content = "WeaponService not found", Duration = 5 })
            end
        end)
        return
    end

    if enabled then
        if not originalGetMouseTarget then
            originalGetMouseTarget = ws.GetMouseTargetCFrame
            originalGetTargetPosition = ws.GetTargetPosition
            originalWeaponRaycast = ws.WeaponRaycast
        end

        ws.GetMouseTargetCFrame = function(self)
            if silentActive then
                local target = getClosestMurdererForSilent()
                if target then
                    return CFrame.new(target.Position)
                end
            end
            return originalGetMouseTarget(self)
        end

        ws.GetTargetPosition = function(self, x, y)
            if silentActive then
                local target = getClosestMurdererForSilent()
                if target then
                    return CFrame.new(target.Position)
                end
            end
            return originalGetTargetPosition(self, x, y)
        end

        if Config.WallBangEnabled then
            if originalWeaponRaycast then
                ws.WeaponRaycast = function(ray)
                    return nil
                end
            end
        else
            if originalWeaponRaycast then
                ws.WeaponRaycast = originalWeaponRaycast
            end
        end
    else
        if originalGetMouseTarget then
            ws.GetMouseTargetCFrame = originalGetMouseTarget
            ws.GetTargetPosition = originalGetTargetPosition
            if originalWeaponRaycast then
                ws.WeaponRaycast = originalWeaponRaycast
            end
            originalGetMouseTarget = nil
            originalGetTargetPosition = nil
            originalWeaponRaycast = nil
        end
    end

    updateSilentFOVCircle()
end

local function updateSilentFOVCircle()
    if not Drawing then return end
    if silentCircleUpdateConn then
        silentCircleUpdateConn:Disconnect()
        silentCircleUpdateConn = nil
    end
    if Config.SilentAimShowFOV and silentActive then
        if not silentFOVCircle then
            silentFOVCircle = Drawing.new("Circle")
            silentFOVCircle.Thickness = 1
            silentFOVCircle.Transparency = 1
            silentFOVCircle.Color = Color3.fromRGB(255, 255, 255)
            silentFOVCircle.NumSides = 64
        end
        silentCircleUpdateConn = RunService.RenderStepped:Connect(function()
            local cam = Workspace.CurrentCamera
            if not cam then return end
            silentFOVCircle.Position = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
            silentFOVCircle.Radius = Config.SilentAimFOVRadius
            silentFOVCircle.Visible = true
        end)
    else
        if silentFOVCircle then
            silentFOVCircle.Visible = false
        end
        if silentCircleUpdateConn then
            silentCircleUpdateConn:Disconnect()
            silentCircleUpdateConn = nil
        end
    end
end

