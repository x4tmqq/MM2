local function startAutoFarm()
    if autoFarmConnection then
        autoFarmConnection:Disconnect()
        autoFarmConnection = nil
    end
    if autoFarmBodyVel then
        autoFarmBodyVel:Destroy()
        autoFarmBodyVel = nil
    end
    autoFarmRunning = false
    autoFarmTarget = nil

    if not Config.AutoFarmEnabled then return end

    setNoclip(true)

    autoFarmRunning = true
    autoFarmConnection = RunService.Heartbeat:Connect(function()
        if not autoFarmRunning or not roundActive then
            if autoFarmBodyVel then
                autoFarmBodyVel:Destroy()
                autoFarmBodyVel = nil
            end
            return
        end

        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local items = {}
        if Config.AutoFarmType == "Coins" then
            items = getCoinObjects()
        elseif Config.AutoFarmType == "Candy" then
            items = getCandyObjects()
        elseif Config.AutoFarmType == "Both" then
            for _, coin in ipairs(getCoinObjects()) do
                table.insert(items, coin)
            end
            for _, candy in ipairs(getCandyObjects()) do
                table.insert(items, candy)
            end
        end

        if #items == 0 then
            if autoFarmBodyVel then
                autoFarmBodyVel:Destroy()
                autoFarmBodyVel = nil
            end
            return end

        local target = nil
        if Config.AutoFarmMethod == "Nearest" then
            local closestDist = math.huge
            for _, item in ipairs(items) do
                if item and item.Parent then
                    local dist = (hrp.Position - item.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        target = item
                    end
                end
            end
        else
            local validItems = {}
            for _, item in ipairs(items) do
                if item and item.Parent then
                    table.insert(validItems, item)
                end
            end
            if #validItems > 0 then
                target = validItems[math.random(1, #validItems)]
            end
        end

        if target then
            autoFarmTarget = target
            local speed = Config.AutoFarmSpeed
            local dir = (target.Position - hrp.Position).Unit
            local dist = (hrp.Position - target.Position).Magnitude

            if not autoFarmBodyVel or autoFarmBodyVel.Parent ~= hrp then
                if autoFarmBodyVel then
                    autoFarmBodyVel:Destroy()
                end
                autoFarmBodyVel = Instance.new("BodyVelocity")
                autoFarmBodyVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                autoFarmBodyVel.Parent = hrp
            end

            if dist > 1 then
                autoFarmBodyVel.Velocity = dir * speed
            else
                autoFarmBodyVel.Velocity = Vector3.new(0, 0, 0)
                collectedCount = collectedCount + 1
                autoFarmTarget = nil
                task.wait(0.1)
            end
        else
            if autoFarmBodyVel then
                autoFarmBodyVel:Destroy()
                autoFarmBodyVel = nil
            end
        end
    end)
    maid:add(autoFarmConnection)
end

