local function setNoclip(enabled: boolean): ()
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end

    if enabled then
        noclipConnection = RunService.Heartbeat:Connect(function()
            local c = LocalPlayer.Character
            if not c then return end
            
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
        maid:add(noclipConnection)
    else
        local c = LocalPlayer.Character
        if c then
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") and (part:IsA("MeshPart") or part:IsA("Part")) then
                    part.CanCollide = true
                end
            end
        end
    end
end

local function cleanFly(): ()
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end
    if flySeat then flySeat:Destroy(); flySeat = nil end
    if flyWeld then flyWeld:Destroy(); flyWeld = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end

    if infiniteJumpConnection then
        infiniteJumpConnection:Disconnect()
        infiniteJumpConnection = nil
    end

    if spamJumpConnection then
        spamJumpConnection:Disconnect()
        spamJumpConnection = nil
    end

    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            if hum.SeatPart then hum:Sit(false) end
        end
    end
    flyActive = false
end

local function setupFlyMovement(): ()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if not flyActive then return end

    flyConnection = RunService.RenderStepped:Connect(function(dt: number)
        if not flyActive then return end
        local c = LocalPlayer.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local cam = Workspace.CurrentCamera
        if not cam then return end

        local move = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            move = move + cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            move = move - cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            move = move - cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            move = move + cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            move = move + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            move = move - Vector3.new(0, 1, 0)
        end

        if move.Magnitude > 0 then
            move = move.Unit
        end

        local method = Config.FlyMethod
        local speed = Config.FlySpeed

        if method == "CFrame" then
            root.CFrame = root.CFrame + move * speed * dt
        elseif method == "BodyVelocity + Gyro" then
            if flyBV and flyBG then
                flyBG.CFrame = cam.CFrame
                flyBV.Velocity = move * speed
            end
        elseif method == "Seat" then
            if flyBV and flyBG and flySeat then
                flyBG.CFrame = cam.CFrame
                flyBV.Velocity = move * speed
            end
        end
    end)
    maid:add(flyConnection)
end

local function setFly(enabled: boolean, method: string, speed: number): ()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    cleanFly()

    if not enabled then
        flyActive = false
        return end

    flyActive = true

    if method == "CFrame" then
        hum.PlatformStand = true
    elseif method == "BodyVelocity + Gyro" then
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Parent = hrp

        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBG.Parent = hrp
    elseif method == "Seat" then
        flySeat = Instance.new("VehicleSeat")
        flySeat.Size = Vector3.new(1, 1, 1)
        flySeat.Transparency = 1
        flySeat.CanCollide = false
        flySeat.Parent = Workspace

        flyWeld = Instance.new("Weld")
        flyWeld.Part0 = hrp
        flyWeld.Part1 = flySeat
        flyWeld.C0 = CFrame.new(0, -1.5, 0)
        flyWeld.Parent = flySeat

        hum:Sit(true)
        hum.PlatformStand = true
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Parent = flySeat

        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBG.Parent = flySeat
    end

    setupFlyMovement()
end

local function setupInfiniteJump(enabled: boolean): ()
    if infiniteJumpConnection then
        infiniteJumpConnection:Disconnect()
        infiniteJumpConnection = nil
    end

    if not enabled then return end

    infiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
        local c = LocalPlayer.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if root and hum then
            local power = Config.JumpPowerEnabled and Config.JumpPower or 50
            root.Velocity = Vector3.new(root.Velocity.X, power, root.Velocity.Z)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
    maid:add(infiniteJumpConnection)
end

local function setupSpamJump(enabled: boolean): ()
    if spamJumpConnection then
        spamJumpConnection:Disconnect()
        spamJumpConnection = nil
    end

    if not enabled then return end

    local c = LocalPlayer.Character
    if not c then return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    task.wait(0.1)
    hum:ChangeState(Enum.HumanoidStateType.Jumping)

    spamJumpConnection = hum.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Landed then
            if hum.Health > 0 then
                task.wait()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
    maid:add(spamJumpConnection)
end

local function clearESP()
    for _, highlight in ipairs(ESPHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    table.clear(ESPHighlights)
    
    clearTracers()
    
    clearSkeletons()
    
    if ESPUpdateConnection then
        ESPUpdateConnection:Disconnect()
        ESPUpdateConnection = nil
    end
end

local function updateTracers()
    if not Drawing then return end
    
    local cam = Workspace.CurrentCamera
    if not cam then return end
    
    local localChar = LocalPlayer.Character
    if not localChar then return end
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    
    local activeTracerRoles = {}
    if ESP.MurdererTracer then activeTracerRoles["Murderer"] = true end
    if ESP.SheriffTracer then activeTracerRoles["Sheriff"] = true end
    if ESP.InnocentTracer then activeTracerRoles["Innocent"] = true end
    
    if not next(activeTracerRoles) then
        clearTracers()
        return
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not root then
            local line = getTracer(tostring(player.UserId))
            if line then line.Visible = false end
            continue
        end
        
        local role, color = getPlayerRole(player)
        local shouldTracer = activeTracerRoles[role] or false
        
        local line = getTracer(tostring(player.UserId))
        if not line then continue end
        
        if shouldTracer then
            if ESP.MaxDistance > 0 then
                local dist = (root.Position - localRoot.Position).Magnitude
                if dist > ESP.MaxDistance then
                    line.Visible = false
                    continue
                end
            end
            
            local vector, onScreen = cam:WorldToViewportPoint(root.Position + Vector3.new(0, 1.5, 0))
            if onScreen then
                line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                line.To = Vector2.new(vector.X, vector.Y)
                line.Color = color
                line.Thickness = 1.5
                line.Transparency = 1
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end

local function updateHighlights()
    local localChar = LocalPlayer.Character
    if not localChar then return end
    
    local localRoot = localChar:FindFirstChild("HumanoidRootPart")
    if not localRoot then return end
    
    local activeHighlightRoles = {}
    if ESP.MurdererHighlight then activeHighlightRoles["Murderer"] = true end
    if ESP.SheriffHighlight then activeHighlightRoles["Sheriff"] = true end
    if ESP.InnocentHighlight then activeHighlightRoles["Innocent"] = true end
    
    if not next(activeHighlightRoles) then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            
            if not root then
                local role, color = getPlayerRole(player)
                local shouldHighlight = activeHighlightRoles[role] or false
                
                if shouldHighlight then
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = player
                    highlight.FillColor = color
                    highlight.FillTransparency = Config.HLFillTrans
                    highlight.OutlineColor = color
                    highlight.OutlineTransparency = Config.HLOutlineTrans
                    highlight.Parent = player
                    table.insert(ESPHighlights, highlight)
                end
                continue
            end
            
            if ESP.MaxDistance > 0 then
                local distance = (root.Position - localRoot.Position).Magnitude
                if distance > ESP.MaxDistance then
                    continue
                end
            end
            
            local role, color = getPlayerRole(player)
            
            if activeHighlightRoles[role] then
                local highlight = Instance.new("Highlight")
                highlight.Adornee = char
                highlight.FillColor = color
                highlight.FillTransparency = Config.HLFillTrans
                highlight.OutlineColor = color
                highlight.OutlineTransparency = Config.HLOutlineTrans
                highlight.Parent = char
                table.insert(ESPHighlights, highlight)
            end
        end
    end
end

local function updateESP()
    for _, highlight in ipairs(ESPHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    table.clear(ESPHighlights)
    
    local hasAnyActive = ESP.MurdererHighlight or ESP.SheriffHighlight or ESP.InnocentHighlight
                        or ESP.MurdererTracer or ESP.SheriffTracer or ESP.InnocentTracer
                        or ESP.MurdererSkeleton or ESP.SheriffSkeleton or ESP.InnocentSkeleton
    
    if not hasAnyActive then
        clearTracers()
        clearSkeletons()
        return
    end
    
    updateHighlights()
    updateTracers()
    updateSkeletons()
end

local function startESP()
    clearESP()
    updateESP()
    
    if ESPUpdateConnection then
        ESPUpdateConnection:Disconnect()
        ESPUpdateConnection = nil
    end
    
    ESPUpdateConnection = RunService.Heartbeat:Connect(function()
        updateESP()
    end)
    maid:add(ESPUpdateConnection)
end

local function onPlayerAdded(player: Player)
    local conn = player.CharacterAdded:Connect(function()
        task.wait(0.2)
        if ESP.MurdererHighlight or ESP.SheriffHighlight or ESP.InnocentHighlight
        or ESP.MurdererTracer or ESP.SheriffTracer or ESP.InnocentTracer
        or ESP.MurdererSkeleton or ESP.SheriffSkeleton or ESP.InnocentSkeleton then
            startESP()
        end
    end)
    characterAddedConnections[player] = conn
    
    if player.Character then
        task.wait(0.2)
        if ESP.MurdererHighlight or ESP.SheriffHighlight or ESP.InnocentHighlight
        or ESP.MurdererTracer or ESP.SheriffTracer or ESP.InnocentTracer
        or ESP.MurdererSkeleton or ESP.SheriffSkeleton or ESP.InnocentSkeleton then
            startESP()
        end
    end
end

local function onPlayerRemoving(player: Player)
    if characterAddedConnections[player] then
        characterAddedConnections[player]:Disconnect()
        characterAddedConnections[player] = nil
    end
    if Drawing then
        local line = getTracer(tostring(player.UserId))
        if line then line.Visible = false end
        if skeletonCache[player] then
            for _, l in pairs(skeletonCache[player]) do
                if l then l.Visible = false end
            end
            skeletonCache[player] = nil
        end
    end
    
    if ESP.MurdererHighlight or ESP.SheriffHighlight or ESP.InnocentHighlight
    or ESP.MurdererTracer or ESP.SheriffTracer or ESP.InnocentTracer
    or ESP.MurdererSkeleton or ESP.SheriffSkeleton or ESP.InnocentSkeleton then
        startESP()
    end
end

