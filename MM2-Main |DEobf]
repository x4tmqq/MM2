local GetPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)

local function updateRoles()
    if Sync then
        local newData = {}
        for _, player in ipairs(Players:GetPlayers()) do
            local name = player.Name
            if Sync[name] and Sync[name].Role then
                newData[name] = { Role = Sync[name].Role }
            end
        end
        if next(newData) then
            PlayerRoles = newData
        end
    end

    if GetPlayerData and GetPlayerData:IsA("RemoteFunction") then
        local success, data = pcall(function()
            return GetPlayerData:InvokeServer()
        end)
        if success and data then
            PlayerRoles = data
        end
    end

    if Event then
        local newData = {}
        for name, info in pairs(PlayerData) do
            if info.Role then
                newData[name] = { Role = info.Role }
            end
        end
        if next(newData) then
            PlayerRoles = newData
        end
    end

    refreshESP()
end

