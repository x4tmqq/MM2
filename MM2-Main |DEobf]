local function getDodgeSideDirection(knifeDirection, hrpPosition, knifePosition)
    local perp = knifeDirection:Cross(Vector3.new(0, 1, 0))
    if perp.Magnitude < 0.01 then
        perp = Vector3.new(1, 0, 0)
    else
        perp = perp.Unit
    end
    local toKnife = Vector3.new(knifePosition.X - hrpPosition.X, 0, knifePosition.Z - hrpPosition.Z)
    if perp:Dot(toKnife) > 0 then
        perp = -perp
    end
    return perp
end

local function tryDodge(knife)
    if not Config.DodgeKnifeThrow then return end
    if not knife or knife.Parent == nil then return end

    local direction = knife:GetAttribute("Direction")
    if not direction then return end

    local knifePos = getKnifePosition(knife)
    if not knifePos then return end

    local hrp, hum = getCharacterForDodge()
    if not hrp or not hum then return end

    local toMe = hrp.Position - knifePos
    local dist = toMe.Magnitude
    if dist > Config.DodgeDetectionRadius then return end

    local dot = direction:Dot(toMe.Unit)
    if dot < 0.6 then return end

    local now = os.clock()
    if now - lastDodgeTime < Config.DodgeCooldown then return end
    lastDodgeTime = now

    local dodgeDir = getDodgeSideDirection(direction, hrp.Position, knifePos)
    
    local currentVel = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(
        dodgeDir.X * Config.DodgeVelocity,
        currentVel.Y,
        dodgeDir.Z * Config.DodgeVelocity
    )
    
    hum.Jump = true
end

local function setupDodge(enabled)
    if dodgeKnifeAddedConnection then
        dodgeKnifeAddedConnection:Disconnect()
        dodgeKnifeAddedConnection = nil
    end
    if dodgeHeartbeatConnection then
        dodgeHeartbeatConnection:Disconnect()
        dodgeHeartbeatConnection = nil
    end
    dodgeActive = false

    if not enabled then return end

    dodgeActive = true
    lastDodgeTime = -Config.DodgeCooldown

    dodgeKnifeAddedConnection = CollectionService:GetInstanceAddedSignal("ThrowingKnife"):Connect(function(knife)
        task.defer(function()
            tryDodge(knife)
        end)
    end)

    dodgeHeartbeatConnection = RunService.Heartbeat:Connect(function()
        if not Config.DodgeKnifeThrow then return end
        local now = os.clock()
        if now - lastDodgeTime < Config.DodgeCooldown then return end
        local hrp, _ = getCharacterForDodge()
        if not hrp then return end
        for _, knife in CollectionService:GetTagged("ThrowingKnife") do
            tryDodge(knife)
            break
        end
    end)

    maid:add(dodgeKnifeAddedConnection)
    maid:add(dodgeHeartbeatConnection)
end

