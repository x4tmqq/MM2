local function getKnifeDirectionFromThrow(handleCFrame, targetCFrame)
    return (targetCFrame.Position - handleCFrame.Position).Unit
end

local function performDodgeWithDirection(dir)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if Config.DodgeMethod == "SafePlace" then
        performSafePlace()
    else
        local up = Vector3.new(0, 1, 0)
        local lateral = dir:Cross(up)
        if lateral.Magnitude < 0.01 then
            lateral = Vector3.new(1, 0, 0)
        end
        lateral = lateral.Unit
        local side = math.random(0, 1) == 0 and 1 or -1
        local dodgeDir = lateral * side
        local speed = 40
        local velocity = dodgeDir * speed + Vector3.new(0, 15, 0)
        root.Velocity = velocity
    end
end

local function setupDescendantDodge()
    dodgeDescendantAddedConn = Workspace.DescendantAdded:Connect(function(child)
        if child:IsA("BasePart") and child.Name == "KnifeVisual" then
            handleKnifeAdded(child)
        end
    end)
end

local function setupDodgeHook()
    if dodgeDescendantAddedConn then
        dodgeDescendantAddedConn:Disconnect()
        dodgeDescendantAddedConn = nil
    end
    if dodgeWeaponConnection then
        dodgeWeaponConnection:Disconnect()
        dodgeWeaponConnection = nil
    end

    if not Config.DodgeKnifeThrow then return end

    local ws = getWeaponService()
    if ws and ws.KnifeThrown then
        dodgeWeaponConnection = ws.KnifeThrown.Event:Connect(function(player, handleCFrame, targetCFrame)
            if Config.DodgeKnifeThrow then
                local dir = getKnifeDirectionFromThrow(handleCFrame, targetCFrame)
                performDodgeWithDirection(dir)
            end
        end)
        return
    end

    setupDescendantDodge()
end

local function performSafePlace()
    if isInSafePlace then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    safePlaceOriginalPos = root.Position
    local safePos = Vector3.new(root.Position.X, 1000, root.Position.Z)
    root.CFrame = CFrame.new(safePos)
    isInSafePlace = true
    if safePlaceTimer then
        safePlaceTimer:Disconnect()
        safePlaceTimer = nil
    end
    safePlaceTimer = task.delay(5, function()
        returnFromSafePlace()
    end)
end

local function returnFromSafePlace()
    if not isInSafePlace then return end
    if safePlaceTimer then
        safePlaceTimer:Disconnect()
        safePlaceTimer = nil
    end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if safePlaceOriginalPos then
        root.CFrame = CFrame.new(safePlaceOriginalPos)
        safePlaceOriginalPos = nil
    end
    isInSafePlace = false
end

local function getKnifeDirection(knife)
    local dir = knife:GetAttribute("Direction")
    if type(dir) == "Vector3" then
        return dir
    end
    return nil
end

local function performDodge(knife)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local dir = getKnifeDirection(knife) or Vector3.new(0,0,1)
    local up = Vector3.new(0, 1, 0)
    local lateral = dir:Cross(up)
    if lateral.Magnitude < 0.01 then
        lateral = Vector3.new(1, 0, 0)
    end
    lateral = lateral.Unit
    local side = math.random(0, 1) == 0 and 1 or -1
    local dodgeDir = lateral * side
    local speed = 40
    local velocity = dodgeDir * speed + Vector3.new(0, 15, 0)
    root.Velocity = velocity
end

local function isInKnifeList(knife)
    for _, k in ipairs(dodgeKnifeList) do
        if k == knife then
            return true
        end
    end
    return false
end

local function removeKnifeFromList(knife)
    for i, k in ipairs(dodgeKnifeList) do
        if k == knife then
            table.remove(dodgeKnifeList, i)
            break
        end
    end
    if Config.DodgeMethod == "SafePlace" and isInSafePlace and #dodgeKnifeList == 0 then
        returnFromSafePlace()
    end
end

local function handleKnifeAdded(knife)
    if not Config.DodgeKnifeThrow then return end
    if not knife:IsA("BasePart") or knife.Name ~= "KnifeVisual" then return end
    if isInKnifeList(knife) then return end

    table.insert(dodgeKnifeList, knife)

    local destroyConn
    destroyConn = knife.AncestryChanged:Connect(function()
        if not knife.Parent then
            destroyConn:Disconnect()
            removeKnifeFromList(knife)
        end
    end)

    if Config.DodgeMethod == "SafePlace" then
        performSafePlace()
    elseif Config.DodgeMethod == "Dodge" then
        performDodge(knife)
    end
end

local function startDodge()
    stopDodge()
    if not Config.DodgeKnifeThrow then return end
    dodgeActive = true
    table.clear(dodgeKnifeList)
    setupDodgeHook()
end

local function stopDodge()
    if dodgeDescendantAddedConn then
        dodgeDescendantAddedConn:Disconnect()
        dodgeDescendantAddedConn = nil
    end
    if dodgeWeaponConnection then
        dodgeWeaponConnection:Disconnect()
        dodgeWeaponConnection = nil
    end
    dodgeActive = false
    if isInSafePlace then
        returnFromSafePlace()
    end
    table.clear(dodgeKnifeList)
end

local function ApplyKillAura()
    for _, conn in ipairs(KillAuraConnections) do
        pcall(conn.Disconnect, conn)
    end
    table.clear(KillAuraConnections)

    if not Config.KillAuraEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local size = Config.KillAuraSize
                    local _, color = getPlayerRole(player)
                    hrp.Size = Vector3.new(size, size, size)
                    hrp.Transparency = Config.KillAuraVisibility
                    hrp.BrickColor = BrickColor.new(color)
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false

                    local conn = hrp:GetPropertyChangedSignal("Size"):Connect(function()
                        if Config.KillAuraEnabled then
                            hrp.Size = Vector3.new(Config.KillAuraSize, Config.KillAuraSize, Config.KillAuraSize)
                        end
                    end)
                    table.insert(KillAuraConnections, conn)
                end
            end
        end
    end
end

local function ClearKillAura()
    for _, conn in ipairs(KillAuraConnections) do
        pcall(conn.Disconnect, conn)
    end
    table.clear(KillAuraConnections)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.Size = Vector3.new(2, 2, 2)
                hrp.Transparency = 1
                hrp.BrickColor = BrickColor.new("Medium stone grey")
                hrp.Material = Enum.Material.Plastic
                hrp.CanCollide = true
            end
        end
    end
end

