                    pcall(function()
                        if WindUI and WindUI.Notify then
                            WindUI:Notify({ Title = "Wall Bang", Content = "Your executor does not support hooks. Wall Bang cannot be activated.", Duration = 6, Icon = "alert-triangle" })
                        end
                    end)
                    return
                end
                setupWallBang(value)
            end
        })
        wallBangToggle:Lock()

        sheriffSection:Toggle({
            Title = "Use FOV Circle",
            Default = Config.SilentAimUseFOV,
            Callback = function(value)
                Config.SilentAimUseFOV = value
                updateSilentFOVCircle()
            end
        })

        sheriffSection:Slider({
            Title = "FOV Radius",
            Value = { Min = 10, Max = 500, Default = Config.SilentAimFOVRadius },
            Rounding = 0,
            Enabled = true,
            Callback = function(value)
                Config.SilentAimFOVRadius = value
                if Config.SilentAimUseFOV then
                    updateSilentFOVCircle()
                end
            end
        })
    end

    do
        local murdererSection = combatTab:Section({
            Title = "Murderer",
            Opened = true,
            Icon = "sword"
        })

        local knifeSilentToggle = murdererSection:Toggle({
            Title = "Knife Silent Aim",
            Desc = "Knife throws automatically aim at the closest player (any role).",
            Default = Config.KnifeSilentAimEnabled,
            Callback = function(value)
                toggleKnifeSilentAim(value)
            end
        })

        local fovToggle = murdererSection:Toggle({
            Title = "Use FOV Circle",
            Default = Config.KnifeSilentAimUseFOV,
            Callback = function(value)
                Config.KnifeSilentAimUseFOV = value
                updateKnifeFOVCircle()
            end
        })

        murdererSection:Slider({
            Title = "FOV Radius",
            Value = { Min = 10, Max = 500, Default = Config.KnifeSilentAimFOVRadius },
            Rounding = 0,
            Enabled = true,
            Callback = function(value)
                Config.KnifeSilentAimFOVRadius = value
                updateKnifeFOVCircle()
            end
        })

        murdererSection:Divider()

        instantThrowToggle = murdererSection:Toggle({
            Title = "Instant Knife Throw",
            Desc = "Throw knife instantly with right-click.",
            Default = Config.InstantKnifeThrowEnabled,
            Callback = function(value)
                if Config.KnifeSilentAimEnabled then
                    Config.InstantKnifeThrowEnabled = true
                    instantThrowToggle:Set(true)
                    instantThrowToggle:Lock()
                    return
                end
                toggleInstantKnifeThrow(value)
            end
        })

        if Config.KnifeSilentAimEnabled then
            instantThrowToggle:Set(true)
            instantThrowToggle:Lock()
        end
    end

    local farmTab = mainWindow:Tab({ Title = "Auto Farm", Icon = "trending-up" })

    do
        local farmSection = farmTab:Section({
            Title = "Auto Farm Settings",
            Opened = true,
            Icon = "settings"
        })

        farmSection:Toggle({
            Title = "Enable Auto Farm",
            Desc = "fastest mm2 auto farm (w x4tmq)",
            Default = false,
            Callback = function(value)
                if not isFeatureSupported("autoFarm") then
                    pcall(function()
                        if WindUI and WindUI.Notify then
                            WindUI:Notify({ Title = "Auto Farm", Content = "Feature not supported by your executor.", Duration = 5, Icon = "alert-triangle" })
                        end
                    end)
                    return
                end
                Config.AutoFarmEnabled = value
                if value then
                    startAutoFarm()
                else
                    stopAutoFarm()
                end
            end
        })

        farmSection:Dropdown({
            Title = "Stuff to farm",
            Values = { "Coins" },
            Value = "Coins",
            Callback = function(value)
                Config.AutoFarmType = value
                if Config.AutoFarmEnabled then
                    stopAutoFarm()
                    startAutoFarm()
                end
            end
        })

        farmSection:Dropdown({
            Title = "Method",
            Values = { "Nearest", "Randomize" },
            Value = "Nearest",
            Callback = function(value)
                Config.AutoFarmMethod = value
            end
        })

        farmSection:Slider({
            Title = "AutoFarm Speed",
            Value = { Min = 1, Max = 25, Default = 25 },
            Rounding = 0,
            Enabled = true,
            Callback = function(value)
                Config.AutoFarmSpeed = value
            end
        })

        farmSection:Divider()

        local autoResetToggle = farmSection:Toggle({
            Title = "Auto Reset Character",
            Default = false,
            Callback = function(value)
                Config.AutoReset = value
            end
        })
        autoResetToggle:Lock()

        local flingToggle = farmSection:Toggle({
            Title = "Auto Fling Murderer",
            Default = false,
            Callback = function(value)
                Config.AutoFlingMurderer = value
            end
        })
        flingToggle:Lock()
    end

    local trollTab = mainWindow:Tab({ Title = "Troll", Icon = "ghost" })

    local epsteinSection = trollTab:Section({
        Title = "Epstein Jutsu",
        Opened = true,
        Icon = "user-plus"
    })

    epsteinDropdown = epsteinSection:Dropdown({
        Title = "Select Target",
        Values = {},
        Callback = function(value)
            if value and value.Title then
                epsteinTarget = Players:FindFirstChild(value.Title)
            end
        end
    })

    refreshEpsteinDropdown()

    epsteinSection:Slider({
        Title = "Jutsu Speed",
        Value = { Min = 1, Max = 20, Default = 5 },
        Rounding = 1,
        Enabled = true,
        Callback = function(value)
            epsteinSpeed = value
        end
    })

    epsteinSection:Divider()

    epsteinFrontToggle = epsteinSection:Toggle({
        Title = "Fuck in the mouth",
        Default = false,
        Callback = function(value)
            if not isFeatureSupported("epsteinJutsu") then
                pcall(function()
                    if WindUI and WindUI.Notify then
                        WindUI:Notify({ Title = "Epstein Jutsu", Content = "Feature not supported by your executor.", Duration = 5, Icon = "alert-triangle" })
                    end
                end)
                return
            end
            if value then
                if epsteinBackToggle then
                    epsteinBackToggle:Set(false)
                end
                epsteinMode = "front"
                startEpsteinJutsu()
            else
                stopEpsteinJutsu()
            end
        end
    })

    epsteinBackToggle = epsteinSection:Toggle({
        Title = "Bang",
        Default = false,
        Callback = function(value)
            if not isFeatureSupported("epsteinJutsu") then
                pcall(function()
                    if WindUI and WindUI.Notify then
                        WindUI:Notify({ Title = "Epstein Jutsu", Content = "Feature not supported by your executor.", Duration = 5, Icon = "alert-triangle" })
                    end
                end)
                return
            end
            if value then
                if epsteinFrontToggle then
                    epsteinFrontToggle:Set(false)
                end
                epsteinMode = "back"
                startEpsteinJutsu()
            else
                stopEpsteinJutsu()
            end
        end
    })
end

local function initialize()
    if not loadWindUI() then
        warn("[Sentinel] Échec du chargement de WindUI.")
        return
    end

    local loadTime = os.clock() - startTime

    print("\n============ Account & Info ============")
    print("User         : " .. userName)
    print("Account Age  : " .. accountAge)
    print("Device       : " .. deviceType)

    print("\n============ Script & Executor ============")
    print("Script Load Time : " .. string.format("%.3f", loadTime) .. "s")
    print("Executor        : " .. executorName)

    printUncLogs()

    if not hookSupported then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({
                    Title = "Warning",
                    Content = "Hooks are not supported. Silent Aim & Wall Bang will not work.",
                    Duration = 10,
                    Icon = "alert-triangle"
                })
            end
        end)
    end

    buildUI()

    if mainWindow then
        mainWindow.Visible = true
    end

    pcall(function()
        if mainWindow and WindUI then
            mainWindow:SelectTab(1)
            WindUI:Notify({ Title = "News", Content = "Welcome to v1", Duration = 5, Icon = "bell" })
            WindUI:Notify({ Title = "Sentinel v1.00.00", Content = "Script Loaded successfully,\n Welcome, user.", Duration = 5, Icon = "check" })
        end
    end)

    playerAddedConnection = Players.PlayerAdded:Connect(onPlayerAdded)
    maid:add(playerAddedConnection)

    playerRemovingConnection = Players.PlayerRemoving:Connect(onPlayerRemoving)
    maid:add(playerRemovingConnection)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            onPlayerAdded(player)
        end
    end

    local playerAddedWhitelistConn = Players.PlayerAdded:Connect(refreshEpsteinDropdown)
    maid:add(playerAddedWhitelistConn)
    local playerRemovingWhitelistConn = Players.PlayerRemoving:Connect(refreshEpsteinDropdown)
    maid:add(playerRemovingWhitelistConn)

    task.spawn(function()
        while true do
            task.wait(7.5)
            refreshEpsteinDropdown()
        end
    end)

    local char = LocalPlayer.Character
    if char then
        setupCharacter(char)
        updateKnifeDelay()
        setupKnifeOverrides()
    end

    local charAddedConn = LocalPlayer.CharacterAdded:Connect(function(char)
        setupCharacter(char)
        updateKnifeDelay()
        task.spawn(function()
            local waitCount = 0
            while waitCount < 50 do
                task.wait(0.1)
                waitCount = waitCount + 1
                local k = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
                if k then
                    setupKnifeOverrides()
                    return
                end
            end
            setupKnifeOverrides()
        end)
    end)
    maid:add(charAddedConn)

    setupFOV()

    task.spawn(function()
        while true do
            task.wait(1)
            refreshESP()
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then
            return
        end
        if input.KeyCode == Enum.KeyCode[Config.GrabKeybind] then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                handleGrabAction()
            end
        end
        if input.KeyCode == Enum.KeyCode.K and mainWindow then
            if not mainWindow.Visible and firstHide then
                firstHide = false
                pcall(function()
                    if WindUI then
                        WindUI:Notify({ Title = "Keybind", Content = "Press K to toggle interface", Duration = 3, Icon = "key" })
                    end
                end)
            end
        end
    end)
end

task.spawn(initialize)
