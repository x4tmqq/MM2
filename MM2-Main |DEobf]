            NightStalkerInfAmmoRunning = true
            if NightStalkerInfAmmoLoopThread then
                task.cancel(NightStalkerInfAmmoLoopThread)
            end
            NightStalkerInfAmmoLoopThread = task.spawn(nightStalkerInfAmmoLoop)
        end
    else
        NightStalkerInfAmmoRunning = false
        if NightStalkerInfAmmoLoopThread then
            task.cancel(NightStalkerInfAmmoLoopThread)
            NightStalkerInfAmmoLoopThread = nil
        end
    end
