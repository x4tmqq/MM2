        local ok, result = pcall(fn)
        if ok then
            return result ~= nil
        else
            return false
        end
    end

    print("\n============ UNC Test ============")
    local function check(label, fn)
        local exists = test(label, fn)
        local icon = exists and "✅" or "❌"
        print(icon .. " " .. label)
    end

    check("hookmetamethod", function() return hookmetamethod ~= nil end)
    check("hookfunction", function() return hookfunction ~= nil end)
    check("__namecall", function() return getnamecallmethod ~= nil end)
    check("__newclosure", function() return newcclosure ~= nil end)
    check("getfenv", function() return getfenv ~= nil end)
    check("Drawing.new", function() return Drawing and Drawing.new ~= nil end)
    check("getrenv", function() return getrenv ~= nil end)
    check("identifyexecutor", function() return identifyexecutor ~= nil end)
    check("setfpscap", function() return setfpscap ~= nil end)
    print("==========================================")
end

local knifeOverrideConnection = nil
local knifeOriginalNamecall = nil
local knifeHookActive = false

local function getKnifeTargetCFrame()
    if not Config.KnifeSilentAimEnabled then return nil end

    local cam = Workspace.CurrentCamera
    if not cam then return nil end

    local char = LocalPlayer.Character
    if not char then return nil end
    local myPos = char:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end

    local screenCenter = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local target = nil
    local shortestDistance = math.huge

    for _, v in pairs(Players:GetPlayers()) do
        if v == LocalPlayer then continue end

        local charTarget = v.Character
        if not charTarget then continue end
        local hrp = charTarget:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end

        if Config.KnifeSilentAimUseFOV then
            local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
            if not onScreen then continue end
            local magnitude = (Vector2.new(pos.X, pos.Y) - screenCenter).Magnitude
            if magnitude > Config.KnifeSilentAimFOVRadius then continue end
        end

        local dist = (hrp.Position - myPos.Position).Magnitude
        if dist < shortestDistance then
            shortestDistance = dist
            target = hrp
        end
    end

    if target then
        return CFrame.new(target.Position)
    end

    local ws = getWeaponService()
    if ws then
        return ws:GetMouseTargetCFrame()
    end
    return nil
end

local function setupKnifeHook()
    if knifeHookActive then
        return
    end

    if not Config.KnifeSilentAimEnabled then
        if knifeOriginalNamecall then
            local mt = getrawmetatable(game)
            if mt then
                setreadonly(mt, false)
                mt.__namecall = knifeOriginalNamecall
                setreadonly(mt, true)
                knifeOriginalNamecall = nil
            end
        end
        knifeHookActive = false
        return
    end

    if not hookSupported then
        setupKnifeOverrideFallback()
        return
    end

    local mt = getrawmetatable(game)
    if not mt then
        return
    end

    setreadonly(mt, false)
    knifeOriginalNamecall = mt.__namecall

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "FireServer" and self.Name == "KnifeThrown" then
            local args = {...}
            if args[2] and type(args[2]) == "CFrame" then
                local newTarget = getKnifeTargetCFrame()
                if newTarget then
                    args[2] = newTarget
                end
            end
            if knifeOriginalNamecall then
                return knifeOriginalNamecall(self, unpack(args))
            else
                return self[method](self, unpack(args))
            end
        end
        if knifeOriginalNamecall then
            return knifeOriginalNamecall(self, ...)
        else
            return self[method](self, ...)
        end
    end)

    setreadonly(mt, true)
    knifeHookActive = true

    local knife = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
    if knife then
        if Config.InstantKnifeThrowEnabled then
            knife:SetAttribute("ThrowSpeed", 0.01)
        else
            knife:SetAttribute("ThrowSpeed", 1)
        end
    end
end

local function setupKnifeOverrideFallback()
    if knifeOverrideConnection then
        knifeOverrideConnection:Disconnect()
        knifeOverrideConnection = nil
    end

    if not Config.KnifeSilentAimEnabled and not Config.InstantKnifeThrowEnabled then
        local char = LocalPlayer.Character
        local knife = char and char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
        if knife then
            local knifeClient = knife:FindFirstChildOfClass("LocalScript")
            if knifeClient then
                knifeClient.Disabled = false
            end
            knife:SetAttribute("ThrowSpeed", 1)
        end
        return
    end

    local knife = waitForKnife()
    if not knife then
        return
    end

    local knifeThrown = knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown")
    local handle = knife:FindFirstChild("Handle")
    if not knifeThrown or not handle then
        return
    end

    local ws = getWeaponService()
    if not ws then
        return
    end

    local function onInputBegan(input, gp)
        if gp then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            local knifeClient = knife:FindFirstChildOfClass("LocalScript")
            if knifeClient then
                knifeClient.Disabled = true
                task.defer(function()
                    if knifeClient then
                        knifeClient.Disabled = false
                    end
                end)
            end

            local target = Config.KnifeSilentAimEnabled and getKnifeTargetCFrame() or ws:GetMouseTargetCFrame()
            if target then
                knifeThrown:FireServer(handle.CFrame, target)
            end
        end
    end

    knifeOverrideConnection = UserInputService.InputBegan:Connect(onInputBegan)
    maid:add(knifeOverrideConnection)

    if Config.InstantKnifeThrowEnabled then
        knife:SetAttribute("ThrowSpeed", 0.01)
    else
        knife:SetAttribute("ThrowSpeed", 1)
    end
end

local function setupKnifeOverrides()
    if hookSupported then
        setupKnifeHook()
    else
        setupKnifeOverrideFallback()
    end
end

local function updateKnifeDelay()
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local knife = char:FindFirstChild("Knife") or LocalPlayer.Backpack:FindFirstChild("Knife")
    if not knife then
        return
    end
    if Config.InstantKnifeThrowEnabled or Config.KnifeSilentAimEnabled then
        knife:SetAttribute("ThrowSpeed", 0.01)
    elseif Config.KnifeAttackDelayEnabled then
        local delay = Config.KnifeAttackDelay
        local attr = math.max(delay / 2, 0.05)
        knife:SetAttribute("ThrowSpeed", attr)
    else
        knife:SetAttribute("ThrowSpeed", 1)
    end
end

local instantThrowToggle = nil

local function toggleKnifeSilentAim(value)
    if value and not isFeatureSupported("knifeSilentAim") then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({
                    Title = "Knife Silent Aim",
                    Content = "Your executor does not support hooks. Using fallback.",
                    Duration = 8,
                    Icon = "alert-triangle"
                })
            end
        end)
        Config.KnifeSilentAimEnabled = false
        return
    end
    Config.KnifeSilentAimEnabled = value

    if value then
        Config.InstantKnifeThrowEnabled = true
        if instantThrowToggle then
            instantThrowToggle:Set(true)
            instantThrowToggle:Lock()
        end
    else
        Config.InstantKnifeThrowEnabled = false
        if instantThrowToggle then
            instantThrowToggle:Set(false)
            instantThrowToggle:Unlock()
        end
    end

    setupKnifeOverrides()
    updateKnifeDelay()
    updateKnifeFOVCircle()
end

local function toggleInstantKnifeThrow(value)
    if Config.KnifeSilentAimEnabled then
        Config.InstantKnifeThrowEnabled = true
        if instantThrowToggle then
            instantThrowToggle:Set(true)
            instantThrowToggle:Lock()
        end
        return
    end

    Config.InstantKnifeThrowEnabled = value
    setupKnifeOverrides()
    updateKnifeDelay()
end

local knifeFOVCircle = nil
local knifeFOVCircleUpdateConn = nil

local function updateKnifeFOVCircle()
    if knifeFOVCircleUpdateConn then
        knifeFOVCircleUpdateConn:Disconnect()
        knifeFOVCircleUpdateConn = nil
    end
    if Config.KnifeSilentAimEnabled and Config.KnifeSilentAimUseFOV then
        if not knifeFOVCircle and Drawing then
            knifeFOVCircle = Drawing.new("Circle")
            knifeFOVCircle.Thickness = 1
            knifeFOVCircle.Transparency = 1
            knifeFOVCircle.Color = Color3.fromRGB(255, 255, 255)
            knifeFOVCircle.NumSides = 64
        end
        if knifeFOVCircle then
            knifeFOVCircleUpdateConn = RunService.RenderStepped:Connect(function()
                local cam = Workspace.CurrentCamera
                if not cam then
                    return
                end
                knifeFOVCircle.Position = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                knifeFOVCircle.Radius = Config.KnifeSilentAimFOVRadius
                knifeFOVCircle.Visible = true
            end)
        end
    else
        if knifeFOVCircle then
            knifeFOVCircle.Visible = false
        end
    end
end

local function waitForKnife()
    local player = LocalPlayer
    local function check()
        local c = player.Character
        if c then
            local k = c:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
            if k then
                return k
            end
        end
        return nil
    end
    local k = check()
    if k then
        return k
    end
    local conn
    local result = nil
    conn = player.CharacterAdded:Connect(function(newChar)
        local k2 = newChar:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife")
        if k2 then
            result = k2
            conn:Disconnect()
        end
    end)
    local conn2 = player.Backpack.ChildAdded:Connect(function(child)
        if child.Name == "Knife" then
            result = child
            conn2:Disconnect()
            if conn then
                conn:Disconnect()
            end
        end
    end)
    repeat
        task.wait()
    until result ~= nil
    return result
end

