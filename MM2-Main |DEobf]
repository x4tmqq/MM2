local function startKillAll()
    if killAllRunning then return end

    local knife = nil
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool.Name == "Knife" then
                knife = tool
                break
            end
        end
    end
    if not knife then
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Knife" then
                    knife = tool
                    break
                end
            end
        end
    end
    if not knife then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Kill All", Content = "No knife found! Cannot start.", Duration = 3 })
            end
        end)
        return
    end

    killAllRunning = true

    task.spawn(function()
        while killAllRunning do
            local target = nil
            local players = Players:GetPlayers()
            for _, p in ipairs(players) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local whitelisted = false
                    for _, name in ipairs(Config.KillAllWhitelist) do
                        if name == p.Name then
                            whitelisted = true
                            break
                        end
                    end
                    if not whitelisted then
                        target = p
                        break
                    end
                end
            end

            if not target then
                task.wait(5)
                continue
            end

            local localChar = LocalPlayer.Character
            if not localChar then
                task.wait(0.5)
                continue
            end
            local localHrp = localChar:FindFirstChild("HumanoidRootPart")
            if not localHrp then
                task.wait(0.5)
                continue
            end

            local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                localHrp.CFrame = targetHrp.CFrame
            end

            local currentKnife = nil
            for _, tool in ipairs(localChar:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == "Knife" then
                    currentKnife = tool
                    break
                end
            end
            if not currentKnife then
                if backpack then
                    for _, tool in ipairs(backpack:GetChildren()) do
                        if tool.Name == "Knife" then
                            currentKnife = tool
                            break
                        end
                    end
                end
            end
            if not currentKnife then
                killAllRunning = false
                pcall(function()
                    if WindUI and WindUI.Notify then
                        WindUI:Notify({ Title = "Kill All", Content = "Knife lost! Stopping.", Duration = 3 })
                    end
                end)
                break
            end

            if currentKnife.Parent ~= localChar then
                currentKnife.Parent = localChar
                task.wait(0.1)
            end

            local targetDied = false
            while not targetDied and killAllRunning do
                if not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") or not target.Character:FindFirstChildOfClass("Humanoid") or target.Character.Humanoid.Health <= 0 then
                    targetDied = true
                    break
                end

                if Config.KnifeAttackDelayEnabled then
                    task.wait(Config.KnifeAttackDelay)
                end
                currentKnife:Activate()
                task.wait(0.1)

                local currentHrp = target.Character:FindFirstChild("HumanoidRootPart")
                if currentHrp and localChar and localChar:FindFirstChild("HumanoidRootPart") then
                    localChar.HumanoidRootPart.CFrame = currentHrp.CFrame
                end
            end

            if targetDied then
                task.wait(0.5)
            end
        end
    end)
end

local function stopKillAll()
    killAllRunning = false
end

