local function grabGunTP()
    local gun = findGunDrop()
    if not gun then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local origPos = root.Position
    root.CFrame = gun.CFrame
    task.wait(0.05)
    if root and root.Parent then
        root.CFrame = CFrame.new(origPos)
    end
    return true
end

local function grabGunGrab()
    local gun = findGunDrop()
    if not gun then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    gun.CFrame = root.CFrame * CFrame.new(0, 1.5, 0)
    return true
end

local function executeGrab()
    local method = Config.GrabMethod
    if method ~= "TP to Gun" and method ~= "Grab" then
        method = "Grab"
    end
    if method == "TP to Gun" then
        return grabGunTP()
    else
        return grabGunGrab()
    end
end

local function playerHasGun(): boolean
    local char = LocalPlayer.Character
    if char then
        if hasItemEquipped(char, "Gun") then
            return true
        end
    end
    if hasItemInBackpack(LocalPlayer, "Gun") then
        return true
    end
    return false
end

local function startAutoGrab()
    if autoGrabConnection then
        autoGrabConnection:Disconnect()
        autoGrabConnection = nil
    end
    autoGrabRunning = false

    if not Config.AutoGrabGun then return end

    autoGrabRunning = true
    autoGrabConnection = RunService.Heartbeat:Connect(function()
        if not autoGrabRunning then return end
        local currentTime = tick()
        if currentTime - lastGrabTime < 1 then return end
        lastGrabTime = currentTime

        if not findGunDrop() then return end
        executeGrab()
    end)
    maid:add(autoGrabConnection)
end

local function stopAutoGrab()
    if autoGrabConnection then
        autoGrabConnection:Disconnect()
        autoGrabConnection = nil
    end
    autoGrabRunning = false
end

local function handleGrabAction()
    local gun = findGunDrop()
    if not gun then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Grab", Content = "Wait for the sheriff to die first", Duration = 3 })
            end
