local function initialize(): ()
    if not loadWindUI() then
        warn("[Sentinel] Échec du chargement de WindUI.")
        return
    end

    buildUI()

    if mainWindow then
        mainWindow.Visible = true
    end

    pcall(function()
        if mainWindow and WindUI then
            mainWindow:SelectTab(1)
            WindUI:Notify({ Title = "News", Content = "Welcome to v1", Duration = 5 })
            WindUI:Notify({ Title = "Sentinel v1.00.00", Content = "Script Loaded successfully,\n Welcome, user.", Duration = 5 })
        end
    end)

    playerAddedConnection = Players.PlayerAdded:Connect(onPlayerAdded)
    maid:add(playerAddedConnection)
    
    playerRemovingConnection = Players.PlayerRemoving:Connect(onPlayerRemoving)
    maid:add(playerRemovingConnection)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            onPlayerAdded(player)
        end
    end

    local char = LocalPlayer.Character
    if char then
        setupCharacter(char)
    end

    local charAddedConn = LocalPlayer.CharacterAdded:Connect(setupCharacter)
    maid:add(charAddedConn)
    
    setupFOV()
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode[Config.GrabKeybind] then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                handleGrabAction()
            end
        end
        if input.KeyCode == Enum.KeyCode.K and mainWindow then
            if not mainWindow.Visible and firstHide then
                firstHide = false
                pcall(function()
                    if WindUI then
                        WindUI:Notify({ Title = "Keybind", Content = "Press K to toggle interface", Duration = 3 })
                    end
                end)
            end
        end
    end)
end

task.spawn(initialize)
