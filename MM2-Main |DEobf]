    local function stopFlingLoop(flingType)
        if flingLoopThreads[flingType] then
            flingLoopActive[flingType] = false
            task.wait(0.1)
            flingLoopThreads[flingType] = nil
        end
    end

    local function startFlingLoop(flingType, getTargetFunc)
        stopFlingLoop(flingType)
        flingLoopActive[flingType] = true
        flingLoopThreads[flingType] = task.spawn(function()
            while flingLoopActive[flingType] do
                local target = getTargetFunc()
                if target then
                    if type(target) == "table" then
                        for _, p in ipairs(target) do
                            if not flingLoopActive[flingType] then break end
                            if p and p.Character then
                                flingPlayer(p)
                            end
                        end
                    else
                        if target and target.Character then
                            flingPlayer(target)
                        else
                            flingLoopActive[flingType] = false
                            pcall(function()
                                if WindUI and WindUI.Notify then
                                    WindUI:Notify({ Title = "Fling", Content = "Target lost, stopping.", Duration = 2, Icon = "alert-circle" })
                                end
                            end)
                        end
                    end
                else
                    flingLoopActive[flingType] = false
                    pcall(function()
                        if WindUI and WindUI.Notify then
                            WindUI:Notify({ Title = "Fling", Content = "No target found, stopping.", Duration = 2, Icon = "alert-circle" })
                        end
                    end)
                end
                task.wait(1.5)
            end
            flingLoopThreads[flingType] = nil
        end)
    end

