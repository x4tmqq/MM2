local function handleAutoReload(tool)
    if not Config.AutoReload then return end
    if not tool or not tool:IsA("Tool") then return end
    local clip = tool:GetAttribute("ClipCurrent")
    if clip == nil then return end
    if type(clip) == "number" and clip <= 0 then
        if AutoReloadLock then return end
        AutoReloadLock = true
        task.wait(0.01)
        if not Config.AutoReload then AutoReloadLock = false; return end
        if not tool:IsDescendantOf(LocalPlayer.Character) and not tool:IsDescendantOf(LocalPlayer.Backpack) then
            AutoReloadLock = false
