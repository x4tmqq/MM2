                                    end
                                end
                            end
                            task.wait(0.2)
                        end
                    end
                    task.spawn(stateMachine)
                    task.wait(60)
                    if infectionIsRunning and humanoid and humanoid.Health > 0 then
                        humanoid.Health = 0
                    end
                    stopInfection()
                    canInfect = true
                end)
            end
        end)
    else
