function setupAutoReload()
    if AutoReloadConnection then AutoReloadConnection:Disconnect(); AutoReloadConnection = nil end
    if not Config.AutoReload then return end

    local function checkCurrentTool()
        local char = LocalPlayer.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:GetAttribute("ClipCurrent") ~= nil then
            if AutoReloadTool ~= tool then
                AutoReloadTool = tool
                if AutoReloadConnection then AutoReloadConnection:Disconnect() end
                AutoReloadConnection = tool:GetAttributeChangedSignal("ClipCurrent"):Connect(function()
                    handleAutoReload(tool)
                end)
            end
        else
            AutoReloadTool = nil
            if AutoReloadConnection then AutoReloadConnection:Disconnect(); AutoReloadConnection = nil end
        end
    end

    checkCurrentTool()
    local char = LocalPlayer.Character
    if char then
        if not char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                checkCurrentTool()
            end
        end) then end
        if not char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                task.wait(0.1)
                checkCurrentTool()
            end
        end) then end
    end
end

function toggleAutoReload(state)
    Config.AutoReload = state
    if state then
        if AutoReloadLoopThread then task.cancel(AutoReloadLoopThread); AutoReloadLoopThread = nil end
        AutoReloadLoopThread = task.spawn(function()
            while Config.AutoReload do
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool and tool:GetAttribute("ClipCurrent") ~= nil then
                        local clip = tool:GetAttribute("ClipCurrent")
                        if type(clip) == "number" and clip <= 0 then
                            if not AutoReloadLock then
                                AutoReloadLock = true
                                VIM:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                                task.wait(0.3)
                                VIM:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                                task.wait(0.1)
                                AutoReloadLock = false
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
        setupAutoReload()
    else
        if AutoReloadLoopThread then task.cancel(AutoReloadLoopThread); AutoReloadLoopThread = nil end
        if AutoReloadConnection then AutoReloadConnection:Disconnect(); AutoReloadConnection = nil end
        AutoReloadTool = nil
        AutoReloadLock = false
    end
end

