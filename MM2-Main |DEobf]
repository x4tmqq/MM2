local function epsteinLoadAnimation(animId)
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end
    epsteinAnimator = animator

    local success, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. tostring(animId))
    end)
    if success and objects and #objects > 0 then
        local function findAnimation(obj)
            if obj:IsA("Animation") then return obj end
            for _, child in ipairs(obj:GetChildren()) do
                local found = findAnimation(child)
                if found then return found end
            end
            return nil
        end
        local animObj = findAnimation(objects[1])
        if animObj then
            local track = animator:LoadAnimation(animObj)
            if track then
                track.Looped = true
                track.Priority = Enum.AnimationPriority.Action
                return track
            end
        end
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(animId)
    return animator:LoadAnimation(anim)
end

local function startEpsteinJutsu()
    if epsteinRunning then
        stopEpsteinJutsu()
    end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid then return end

    if not epsteinTarget or not epsteinTarget.Character then
        pcall(function()
            if WindUI and WindUI.Notify then
                WindUI:Notify({ Title = "Epstein Jutsu", Content = "No target selected!", Duration = 2, Icon = "user-x" })
            end
        end)
        return
    end

    epsteinNoclipConn = RunService.Heartbeat:Connect(function()
        epsteinEnableNoclip()
    end)

    epsteinBodyPos = Instance.new("BodyPosition")
    epsteinBodyPos.MaxForce = Vector3.new(4000, 4000, 4000)
    epsteinBodyPos.P = 2000
    epsteinBodyPos.D = 500
    epsteinBodyPos.Parent = root

    epsteinTrack = epsteinLoadAnimation("73675858945068")
    if epsteinTrack then
        epsteinTrack.Looped = true
        epsteinTrack.Priority = Enum.AnimationPriority.Action
        epsteinTrack:Play()
    end

    epsteinRunning = true

    epsteinConnection = RunService.RenderStepped:Connect(function()
        if not epsteinRunning then return end
        local c = LocalPlayer.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not r or not h then return end

        if h.Health <= 0 then
            stopEpsteinJutsu()
            return
        end

        if not epsteinTarget or not epsteinTarget.Character then
            stopEpsteinJutsu()
            pcall(function()
                if WindUI and WindUI.Notify then
                    WindUI:Notify({ Title = "Epstein Jutsu", Content = "Target lost! Stopping.", Duration = 2, Icon = "alert-circle" })
                end
            end)
            return
        end

        local targetHead = epsteinTarget.Character:FindFirstChild("Head")
        if not targetHead then
            stopEpsteinJutsu()
            return
        end

        local targetHumanoid = epsteinTarget.Character:FindFirstChildOfClass("Humanoid")
        if not targetHumanoid or targetHumanoid.Health <= 0 then
            stopEpsteinJutsu()
            pcall(function()
                if WindUI and WindUI.Notify then
                    WindUI:Notify({ Title = "Epstein Jutsu", Content = "Target is dead! Stopping.", Duration = 2, Icon = "skull" })
                end
            end)
            return
        end

        local speed = epsteinSpeed or 5
        local offsetForward = 1
        local offsetHeight
        local direction

        if epsteinMode == "front" then
            offsetHeight = 1
            direction = 1
        else
            offsetHeight = -1.5
            direction = -1
        end

        local targetPos = targetHead.Position + targetHead.CFrame.LookVector * offsetForward * direction
        targetPos = Vector3.new(targetPos.X, targetHead.Position.Y + offsetHeight, targetPos.Z)

        epsteinBodyPos.Position = targetPos

        local lookDir = (targetHead.Position - targetPos)
        lookDir = Vector3.new(lookDir.X, 0, lookDir.Z).Unit
        if lookDir.Magnitude > 0 then
            r.CFrame = CFrame.new(targetPos, targetPos + lookDir)
        else
            r.CFrame = CFrame.new(targetPos)
