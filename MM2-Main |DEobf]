-- Fonctions utilitaires (hasItemInBackpack, hasItemEquipped)
local function hasItemInBackpack(player, itemName)
    local backpack = player:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name:find(itemName) then
                return true
            end
        end
    end
    return false
end

local function hasItemEquipped(char, itemName)
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") and item.Name:find(itemName) then
            return true
        end
    end
    return false
end

